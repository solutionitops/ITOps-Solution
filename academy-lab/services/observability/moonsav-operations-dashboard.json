      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 10,
      "title": "Live Container Logs Stream ({job=\"moonsav-containers\"})",
      "type": "logs",
      "targets": [
        {
          "expr": "{job=\"moonsav-containers\"} |= \"\"",
          "legendFormat": "{{service}}"
        }
      ]
    }
